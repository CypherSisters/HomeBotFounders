{
  "_about": "PuffPAI offline workout library. Programs follow published exercise-science guidance (sources listed per program). Not medical advice — consult a physician before starting a new program. Optional web refresh can extend this library later; the base always works offline.",
  "_ids": "Every resistance exercise carries an 'id' matching the dashboard's EXERCISE_DB (app/_lib/fitnessScience.ts). That id is what fit_log_set stores, so a session picked from this library round-trips into FitFam history, PRs and Epley 1RMs without a name-matching step. Play/cardio items have no id on purpose: there is nothing to load-log.",
  "_version": "2026-08-14",
  "programs": {
    "readiness_minimalist": {
      "title": "Readiness Minimalist",
      "audience": "Experienced lifter with minimal home equipment: bodyweight, a pull-up bar, a fixed barbell and one kettlebell",
      "days_per_week": 4,
      "sources": [
        "ACSM Position Stand: Progression Models in Resistance Training for Healthy Adults (Med Sci Sports Exerc)",
        "Schoenfeld et al.: Effects of Load on Muscular Adaptations, 6-20+ rep loads grow muscle when taken near failure (J Strength Cond Res)",
        "Pak/Grgic: Effort and time-under-tension as progression levers when external load is fixed"
      ],
      "guidance": "No fixed weekly split, the engine picks train/light/rest from daily readiness. Load is deliberately light (45 lb bar, 35 lb KB), so progression is reps, tempo, density, single-arm/unilateral loading, and bodyweight skill steps, NOT plates. Take working sets to RPE 8; when you clear the top of a rep range with clean form, advance the movement (harder variation, slower tempo, or hang the KB) rather than hunting for weight you do not own.",
      "sessions": [
        {
          "name": "Push",
          "duration_min": 45,
          "exercises": [
            {
              "id": "ohp",
              "name": "Strict Overhead Press",
              "sets": 4,
              "reps": "6-8",
              "rest_sec": 150,
              "notes": "45 lb bar. Keep your legs still and let your shoulders do the pressing, no bouncing to help it up. Since the weight's fixed, get stronger by pausing at your forehead and lowering slowly over about 3 seconds before you add a set."
            },
            {
              "id": "pushup",
              "name": "Push-Up",
              "sets": 4,
              "reps": "12-20",
              "rest_sec": 90,
              "notes": "Bodyweight. Once you can do 20 clean reps, make it harder with feet-up or one-sided push-ups. That's how you progress here, not by adding weight."
            },
            {
              "id": "dip",
              "name": "Dip",
              "sets": 3,
              "reps": "8-12",
              "rest_sec": 120,
              "notes": "Bodyweight on bars or between two solid surfaces. Lower yourself slowly, about 3 seconds; once 12 reps feel easy, hang the 35 lb kettlebell from a belt for more."
            },
            {
              "id": "dumbbell-shoulder-press",
              "name": "Single-Arm KB Press",
              "sets": 3,
              "reps": "8-10/arm",
              "rest_sec": 90,
              "notes": "35 lb kettlebell, one arm at a time. The weight's on one side, so it'll try to tip you over. That's the point. Stay tall and even, don't lean."
            },
            {
              "id": "lateral-raise",
              "name": "KB Lateral Raise",
              "sets": 2,
              "reps": "12-15/arm",
              "rest_sec": 60,
              "notes": "One arm with the 35 lb kettlebell, or something lighter. Raise slowly with no swinging. You're after the burn, not how high it goes."
            }
          ],
          "cooldown": [
            {
              "id": "doorway-pec-stretch",
              "name": "Doorway Pec Stretch",
              "hold": "30s per side"
            },
            {
              "id": "cross-body-shoulder-stretch",
              "name": "Cross-Body Shoulder Stretch",
              "hold": "30s per side"
            },
            {
              "id": "overhead-triceps-stretch",
              "name": "Overhead Triceps Stretch",
              "hold": "30s per side"
            },
            {
              "id": "thoracic-extension-stretch",
              "name": "Thoracic Extension",
              "hold": "5 slow reaches"
            }
          ]
        },
        {
          "name": "Pull",
          "duration_min": 45,
          "exercises": [
            {
              "id": "pullup",
              "name": "Pull-Up",
              "sets": 4,
              "reps": "6-10",
              "rest_sec": 150,
              "notes": "Bodyweight, from a full hang up to your chin over the bar. Once you can do 12 clean reps, hang the 35 lb kettlebell from a belt to make it harder."
            },
            {
              "id": "barbell-row",
              "name": "Barbell Row",
              "sets": 4,
              "reps": "8-12",
              "rest_sec": 120,
              "notes": "45 lb bar, upper body bent forward. The weight's fixed, so add reps, squeeze for a second at the top, and lower the bar back down slowly."
            },
            {
              "id": "dumbbell-row",
              "name": "Single-Arm KB Row",
              "sets": 3,
              "reps": "10-12/arm",
              "rest_sec": 90,
              "notes": "35 lb kettlebell, one arm, with your other hand braced on a bench or knee. Let it stretch all the way down, then pull your elbow back toward your hip."
            },
            {
              "id": "barbell-curl",
              "name": "Barbell Curl",
              "sets": 3,
              "reps": "10-15",
              "rest_sec": 75,
              "notes": "45 lb bar. No swinging, lower it slowly over about 3 seconds and squeeze hard at the top, and even a light bar gives you plenty."
            },
            {
              "id": "face-pull",
              "name": "Face Pull",
              "sets": 3,
              "reps": "15-20",
              "rest_sec": 60,
              "notes": "Use a band, or row a bar or rings toward your face. Hold the squeeze for a second at the end. This keeps the backs of your shoulders healthy."
            }
          ],
          "cooldown": [
            {
              "id": "childs-pose-lat-stretch",
              "name": "Child's Pose (lat bias)",
              "hold": "45s per side"
            },
            {
              "id": "biceps-wall-stretch",
              "name": "Biceps Wall Stretch",
              "hold": "30s per side"
            },
            {
              "id": "forearm-flexor-stretch",
              "name": "Forearm Flexor Stretch",
              "hold": "30s per side"
            },
            {
              "id": "neck-side-stretch",
              "name": "Neck Side Stretch",
              "hold": "30s per side"
            }
          ]
        },
        {
          "name": "Legs",
          "duration_min": 45,
          "exercises": [
            {
              "id": "front-squat",
              "name": "Tempo Front Squat",
              "sets": 4,
              "reps": "8-12",
              "rest_sec": 120,
              "notes": "45 lb bar held across the front of your shoulders. Lower over 3 seconds, pause 1 second at the bottom, stand up in 1, a light bar moved slowly is not an easy set. Swap in goblet squats if the front hold is uncomfortable."
            },
            {
              "id": "bulgarian-split-squat",
              "name": "KB Bulgarian Split Squat",
              "sets": 4,
              "reps": "10-15/leg",
              "rest_sec": 90,
              "notes": "Your best friend when weight is limited, hold the 35 lb kettlebell at your chest, or in one hand down at your side. Add reps, then lower slowly and pause at the bottom so you never miss having more weight."
            },
            {
              "id": "rdl",
              "name": "Romanian Deadlift",
              "sets": 3,
              "reps": "10-15",
              "rest_sec": 120,
              "notes": "45 lb bar. Push your hips back and feel the stretch down the back of your thighs, go for a good stretch and a full pause at the bottom, not a big number."
            },
            {
              "id": "kettlebell-swing",
              "name": "Kettlebell Swing",
              "sets": 4,
              "reps": "15-20",
              "rest_sec": 75,
              "notes": "35 lb kettlebell. Snap your hips forward hard and stand tall and straight at the top. This builds power and gets you breathing. Keep every rep sharp."
            },
            {
              "id": "hanging-leg-raise",
              "name": "Hanging Leg Raise",
              "sets": 3,
              "reps": "8-15",
              "rest_sec": 60,
              "notes": "Hanging from the pull-up bar. Start with bent knees; once you can do 15 clean, move to straight-leg raises."
            }
          ],
          "cooldown": [
            {
              "id": "standing-quad-stretch",
              "name": "Standing Quad Stretch",
              "hold": "30s per side"
            },
            {
              "id": "seated-hamstring-stretch",
              "name": "Seated Hamstring Stretch",
              "hold": "45s per side"
            },
            {
              "id": "figure-four-glute-stretch",
              "name": "Figure-Four Glute Stretch",
              "hold": "45s per side"
            },
            {
              "id": "calf-wall-stretch",
              "name": "Calf Wall Stretch",
              "hold": "30s per side"
            }
          ]
        },
        {
          "name": "Full-Body / Conditioning",
          "duration_min": 40,
          "exercises": [
            {
              "id": "turkish-get-up",
              "name": "Turkish Get-Up",
              "sets": 3,
              "reps": "3-5/side",
              "rest_sec": 90,
              "notes": "35 lb kettlebell, slow and deliberate, settle into every position. This builds whole-body control and steady shoulders; go for quality, not speed."
            },
            {
              "id": "kettlebell-swing",
              "name": "Kettlebell Swing",
              "sets": 4,
              "reps": "20",
              "rest_sec": 60,
              "notes": "35 lb kettlebell at a steady, breathless pace. Keep snapping your hips sharply even when you're breathing hard."
            },
            {
              "id": "farmer-carry",
              "name": "Farmer Carry",
              "sets": 4,
              "reps": "40m",
              "rest_sec": 75,
              "notes": "35 lb kettlebell, one in each hand if you have two, otherwise carry one at your side like a suitcase and switch hands each round. Stand tall, ribs down."
            },
            {
              "id": "goblet-squat",
              "name": "Goblet Squat",
              "sets": 3,
              "reps": "12-15",
              "rest_sec": 75,
              "notes": "35 lb kettlebell held at your chest. Stay upright, squat all the way down, stay controlled. Keep your rests short so it stays challenging."
            },
            {
              "id": "plank",
              "name": "Plank",
              "sets": 3,
              "reps": "45-60s",
              "rest_sec": 45,
              "notes": "Squeeze your core and glutes tight. Once 60 seconds feels easy, add time or slow shoulder taps."
            }
          ],
          "cooldown": [
            {
              "id": "worlds-greatest-stretch",
              "name": "World's Greatest Stretch",
              "hold": "5 reaches per side"
            },
            {
              "id": "downward-dog-stretch",
              "name": "Downward Dog",
              "hold": "45s"
            },
            {
              "id": "kneeling-hip-flexor-stretch",
              "name": "Kneeling Hip Flexor Stretch",
              "hold": "30s per side"
            },
            {
              "id": "childs-pose-lat-stretch",
              "name": "Child's Pose",
              "hold": "45s"
            }
          ]
        }
      ]
    },
